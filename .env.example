# ─── Jane (Anthropic) ────────────────────────────────────────────
# LOCAL DEV ONLY: a key here is bundled into the browser. Fine for
# local testing, NOT for a public deploy. For production, leave this
# blank and use the /api/jane proxy instead (see below).
VITE_ANTHROPIC_API_KEY=

# PRODUCTION: set this (no VITE_ prefix) in Vercel so the key stays on
# the server, and set VITE_JANE_PROXY=1 so the frontend routes to /api/jane.
# ANTHROPIC_API_KEY=sk-ant-...        # set in Vercel, not in this file
VITE_JANE_PROXY=

# ─── Team mode (Firebase) — lets two phones work together ─────────
# Create a free Firebase project, add a Web App, enable Firestore, and
# paste the config values here (and into Vercel). Same values on both
# phones = same live team. Leave blank to run solo / local-only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: a private team id so only you two share state.
# Defaults to "bhumi-duo". Can also be passed per-device via ?team=... in the URL.
VITE_TEAM_ID=
